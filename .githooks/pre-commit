#!/usr/bin/env bash
# Blocks commits that contain keys, passwords, tokens, or secret files — also in commented-out lines.
# Turned on by scripts/setup-git-hooks.sh (git config core.hooksPath .githooks).
# Never bypass it with --no-verify for a secret: move the value to a git-ignored .env file instead.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

node scripts/check-secrets.mjs --staged

# Second opinion with gitleaks' 150+ provider rules, when it is installed (brew install gitleaks).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --pre-commit --redact --no-banner --config .gitleaks.toml || {
    echo "✗ gitleaks found a secret in the staged changes (see above). Remove it before committing."
    exit 1
  }
fi
