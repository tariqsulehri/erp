generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId             String               @map("group_id") @db.Uuid
  name                String               @db.VarChar(100)
  description         String?
  registrationNumber  String?              @map("registration_number") @db.VarChar(20)
  taxId               String?              @map("tax_id") @db.VarChar(50)
  currencyCode        String?              @default("PKR") @map("currency_code") @db.VarChar(3)
  address             String?              @db.VarChar(200)
  city                String?              @db.VarChar(100)
  country             String?              @db.VarChar(100)
  phone               String?              @db.VarChar(20)
  email               String?              @db.VarChar(100)
  fiscalYearBasis     String               @default("calendar") @map("fiscal_year_basis") @db.VarChar(50)
  numberOfPeriods     Int                  @default(12) @map("number_of_periods")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companyGroup        CompanyGroup         @relation(fields: [groupId], references: [id], onUpdate: NoAction)
  brands              Brand[]
  inventoryCategories InventoryCategory[]
  inventoryItemGroups InventoryItemGroup[]
  itemSizes           ItemSize[]
  inventoryItems      InventoryItem[]
  origins             Origin[]
  productTypes        ProductType[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  unitsOfMeasure      UnitOfMeasure[]
  warehouseLocations  WarehouseLocation[]
  warehouses          Warehouse[]
  bankAccounts        BankAccount[]
  bankDepositTypes    BankDepositType[]
  bankDeposits        BankDeposit[]
  bankDepositLines    BankDepositLine[]

  @@map("companies")
}

model Account {
  id                 String            @id(map: "PK_5a7a02c20412299d198e097a8fe") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  code               String            @db.VarChar(10)
  name               String            @db.VarChar(100)
  description        String?
  accountType        String            @map("account_type") @db.VarChar(50)
  normalBalance      String            @map("normal_balance") @db.VarChar(10)
  isPosting          Boolean           @default(false) @map("is_posting")
  isSystem           Boolean           @default(false) @map("is_system")
  isActive           Boolean           @default(true) @map("is_active")
  sortOrder          Int?              @default(0) @map("sort_order")
  categoryId         String?           @map("category_id") @db.Uuid
  taxCodes           Json?             @map("tax_codes")
  attributes         Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?           @map("updated_by_user_id") @db.Uuid
  auditMetadata      Json?             @map("audit_metadata")
  isDeleted          Boolean           @default(false) @map("is_deleted")
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId    String?           @map("deleted_by_user_id") @db.Uuid
  openingBalance     Decimal?          @map("opening_balance") @db.Decimal(15, 2)
  openingBalanceDate DateTime?         @map("opening_balance_date") @db.Date
  bankAccounts       BankAccount[]     @relation("BankAccountLedgerAccount")
  bankDepositLines   BankDepositLine[] @relation("BankDepositLineReceivedFromAccount")

  @@unique([companyId, code], map: "idx_accounts_company_code")
  @@index([code], map: "idx_accounts_code")
  @@index([companyId, isActive, isDeleted], map: "idx_accounts_company_active")
  @@index([companyId, isPosting, isDeleted], map: "idx_accounts_company_posting")
  @@map("accounts")
}

model FiscalYear {
  id                 String         @id(map: "PK_0470d6bc5c757d488b7b04e1899") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  fiscalYear         String         @map("fiscal_year") @db.VarChar(50)
  yearBasis          String         @default("calendar") @map("year_basis") @db.VarChar(20)
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime       @map("end_date") @db.Date
  numberOfPeriods    Int            @default(12) @map("number_of_periods")
  periodType         String         @default("monthly") @map("period_type") @db.VarChar(20)
  postingCutoffDays  Int            @default(0) @map("posting_cutoff_days")
  status             String         @default("open") @db.VarChar(20)
  isActive           Boolean        @default(true) @map("is_active")
  isLocked           Boolean        @default(false) @map("is_locked")
  lockedAt           DateTime?      @map("locked_at") @db.Timestamptz(6)
  lockedByUserId     String?        @map("locked_by_user_id") @db.Uuid
  closingStartedAt   DateTime?      @map("closing_started_at") @db.Timestamptz(6)
  closingCompletedAt DateTime?      @map("closing_completed_at") @db.Timestamptz(6)
  transactionCount   Int            @default(0) @map("transaction_count")
  totalDebits        Decimal        @default(0) @map("total_debits") @db.Decimal(18, 2)
  totalCredits       Decimal        @default(0) @map("total_credits") @db.Decimal(18, 2)
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId    String?        @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?        @map("updated_by_user_id") @db.Uuid
  auditMetadata      Json?          @map("audit_metadata")
  isDeleted          Boolean        @default(false) @map("is_deleted")
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId    String?        @map("deleted_by_user_id") @db.Uuid
  periods            FiscalPeriod[]

  @@unique([companyId, fiscalYear], map: "idx_fiscal_years_company_year")
  @@index([companyId, isActive, isDeleted], map: "idx_fiscal_years_company_active")
  @@index([startDate, endDate], map: "idx_fiscal_years_dates")
  @@map("fiscal_years")
}

model FiscalPeriod {
  id                String     @id(map: "PK_9bb1e4e84a0d820b943e116888d") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  fiscalYearId      String     @map("fiscal_year_id") @db.Uuid
  periodNumber      Int        @map("period_number")
  periodName        String     @map("period_name") @db.VarChar(100)
  startDate         DateTime   @map("start_date") @db.Date
  endDate           DateTime   @map("end_date") @db.Date
  status            String     @default("open") @db.VarChar(20)
  isOpen            Boolean    @default(true) @map("is_open")
  isLocked          Boolean    @default(false) @map("is_locked")
  lockedAt          DateTime?  @map("locked_at") @db.Timestamptz(6)
  lockedByUserId    String?    @map("locked_by_user_id") @db.Uuid
  postingCutoffDays Int        @map("posting_cutoff_days")
  transactionCount  Int        @default(0) @map("transaction_count")
  totalDebits       Decimal    @default(0) @map("total_debits") @db.Decimal(18, 2)
  totalCredits      Decimal    @default(0) @map("total_credits") @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId   String?    @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?    @map("updated_by_user_id") @db.Uuid
  auditMetadata     Json?      @map("audit_metadata")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId   String?    @map("deleted_by_user_id") @db.Uuid
  fiscalYear        FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade, map: "FK_af27b93d80a9090ef6b00f846f9")

  @@unique([fiscalYearId, periodNumber], map: "idx_fiscal_periods_fy_number")
  @@index([startDate, endDate], map: "idx_fiscal_periods_dates")
  @@index([fiscalYearId, isOpen, isDeleted], map: "idx_fiscal_periods_fy_open")
  @@map("fiscal_periods")
}

model Voucher {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  voucherNumber String        @map("voucher_number") @db.VarChar(30)
  voucherType   String        @map("voucher_type") @db.VarChar(5)
  voucherDate   DateTime      @map("voucher_date") @db.Date
  reference     String?       @db.VarChar(100)
  narration     String?
  status        String        @default("Draft") @db.VarChar(20)
  totalDebit    Decimal       @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit   Decimal       @default(0) @map("total_credit") @db.Decimal(18, 2)
  createdBy     String?       @map("created_by") @db.Uuid
  postedBy      String?       @map("posted_by") @db.Uuid
  postedAt      DateTime?     @map("posted_at") @db.Timestamptz(6)
  voidedBy      String?       @map("voided_by") @db.Uuid
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason    String?       @map("void_reason")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines         VoucherLine[]
  bankDeposit   BankDeposit?

  @@unique([companyId, voucherNumber], map: "uq_voucher_number")
  @@index([companyId, voucherDate], map: "idx_vouchers_company_date")
  @@index([companyId, status], map: "idx_vouchers_company_status")
  @@map("vouchers")
}

model VoucherLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId    String   @map("voucher_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  accountCode  String   @map("account_code") @db.VarChar(10)
  accountName  String   @map("account_name") @db.VarChar(200)
  debitAmount  Decimal  @default(0) @map("dr_amount") @db.Decimal(18, 2)
  creditAmount Decimal  @default(0) @map("cr_amount") @db.Decimal(18, 2)
  narration    String?
  lineNo       Int      @default(1) @map("line_no")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId], map: "idx_voucher_lines_account")
  @@index([voucherId], map: "idx_voucher_lines_voucher")
  @@map("voucher_lines")
}

model BankAccount {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  ledgerAccountId    String        @map("ledger_account_id") @db.Uuid
  bankName           String        @map("bank_name") @db.VarChar(150)
  branchName         String?       @map("branch_name") @db.VarChar(150)
  accountTitle       String        @map("account_title") @db.VarChar(200)
  accountNumber      String        @map("account_number") @db.VarChar(80)
  iban               String?       @db.VarChar(34)
  swiftCode          String?       @map("swift_code") @db.VarChar(20)
  currencyCode       String        @default("PKR") @map("currency_code") @db.VarChar(3)
  openingBalance     Decimal       @default(0) @map("opening_balance") @db.Decimal(18, 2)
  openingBalanceDate DateTime?     @map("opening_balance_date") @db.Date
  isDefault          Boolean       @default(false) @map("is_default")
  notes              String?
  isActive           Boolean       @default(true) @map("is_active")
  createdById        String?       @map("created_by_id") @db.Uuid
  updatedById        String?       @map("updated_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company            Company       @relation(fields: [companyId], references: [id])
  ledgerAccount      Account       @relation("BankAccountLedgerAccount", fields: [ledgerAccountId], references: [id])
  bankDeposits       BankDeposit[]

  @@unique([companyId, ledgerAccountId], map: "uq_bank_accounts_ledger_account")
  @@unique([companyId, accountNumber], map: "uq_bank_accounts_account_number")
  @@index([companyId, isActive], map: "idx_bank_accounts_company_active")
  @@index([companyId, bankName], map: "idx_bank_accounts_company_bank_name")
  @@map("bank_accounts")
}

model BankDepositType {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  code        String            @db.VarChar(30)
  name        String            @db.VarChar(120)
  depositKind String            @default("OTHER") @map("deposit_kind") @db.VarChar(30)
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  createdById String?           @map("created_by_id") @db.Uuid
  updatedById String?           @map("updated_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company     Company           @relation(fields: [companyId], references: [id])
  lines       BankDepositLine[]

  @@unique([companyId, code], map: "uq_bank_deposit_types_code")
  @@index([companyId, isActive], map: "idx_bank_deposit_types_company_active")
  @@index([companyId, depositKind], map: "idx_bank_deposit_types_company_kind")
  @@map("bank_deposit_types")
}

model BankDeposit {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  voucherId         String?           @unique(map: "uq_bank_deposits_voucher") @map("voucher_id") @db.Uuid
  bankAccountId     String            @map("bank_account_id") @db.Uuid
  depositNumber     String            @map("deposit_number") @db.VarChar(40)
  depositDate       DateTime          @map("deposit_date") @db.Date
  referenceNumber   String?           @map("reference_number") @db.VarChar(100)
  description       String?
  status            String            @default("Draft") @db.VarChar(20)
  cashTotal         Decimal           @default(0) @map("cash_total") @db.Decimal(18, 2)
  chequeTotal       Decimal           @default(0) @map("cheque_total") @db.Decimal(18, 2)
  transferTotal     Decimal           @default(0) @map("transfer_total") @db.Decimal(18, 2)
  otherTotal        Decimal           @default(0) @map("other_total") @db.Decimal(18, 2)
  totalAmount       Decimal           @default(0) @map("total_amount") @db.Decimal(18, 2)
  bankBalanceBefore Decimal?          @map("bank_balance_before") @db.Decimal(18, 2)
  bankBalanceAfter  Decimal?          @map("bank_balance_after") @db.Decimal(18, 2)
  createdById       String?           @map("created_by_id") @db.Uuid
  updatedById       String?           @map("updated_by_id") @db.Uuid
  postedById        String?           @map("posted_by_id") @db.Uuid
  postedAt          DateTime?         @map("posted_at") @db.Timestamptz(6)
  voidedById        String?           @map("voided_by_id") @db.Uuid
  voidedAt          DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidReason        String?           @map("void_reason")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company           Company           @relation(fields: [companyId], references: [id])
  voucher           Voucher?          @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  lines             BankDepositLine[]

  @@unique([companyId, depositNumber], map: "uq_bank_deposits_number")
  @@index([companyId, depositDate], map: "idx_bank_deposits_company_date")
  @@index([companyId, status], map: "idx_bank_deposits_company_status")
  @@index([companyId, bankAccountId, depositDate], map: "idx_bank_deposits_company_bank_date")
  @@index([companyId, isActive], map: "idx_bank_deposits_company_active")
  @@map("bank_deposits")
}

model BankDepositLine {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String          @map("company_id") @db.Uuid
  bankDepositId           String          @map("bank_deposit_id") @db.Uuid
  lineNumber              Int             @default(1) @map("line_number")
  receivedFromAccountId   String          @map("received_from_account_id") @db.Uuid
  receivedFromAccountCode String          @map("received_from_account_code") @db.VarChar(20)
  receivedFromAccountName String          @map("received_from_account_name") @db.VarChar(200)
  depositTypeId           String          @map("deposit_type_id") @db.Uuid
  depositTypeName         String          @map("deposit_type_name") @db.VarChar(120)
  description             String?
  chequeNumber            String?         @map("cheque_number") @db.VarChar(80)
  chequeDate              DateTime?       @map("cheque_date") @db.Date
  chequeBankName          String?         @map("cheque_bank_name") @db.VarChar(150)
  clearingDate            DateTime?       @map("clearing_date") @db.Date
  amount                  Decimal         @db.Decimal(18, 2)
  isCleared               Boolean         @default(false) @map("is_cleared")
  clearedAt               DateTime?       @map("cleared_at") @db.Timestamptz(6)
  isActive                Boolean         @default(true) @map("is_active")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                 Company         @relation(fields: [companyId], references: [id])
  bankDeposit             BankDeposit     @relation(fields: [bankDepositId], references: [id], onDelete: Cascade)
  receivedFromAccount     Account         @relation("BankDepositLineReceivedFromAccount", fields: [receivedFromAccountId], references: [id])
  depositType             BankDepositType @relation(fields: [depositTypeId], references: [id])

  @@unique([bankDepositId, lineNumber], map: "uq_bank_deposit_lines_number")
  @@index([companyId, bankDepositId], map: "idx_bank_deposit_lines_deposit")
  @@index([companyId, receivedFromAccountId], map: "idx_bank_deposit_lines_received_from")
  @@index([companyId, depositTypeId], map: "idx_bank_deposit_lines_deposit_type")
  @@index([companyId, clearingDate], map: "idx_bank_deposit_lines_clearing_date")
  @@index([companyId, isCleared], map: "idx_bank_deposit_lines_cleared")
  @@index([companyId, isActive], map: "idx_bank_deposit_lines_company_active")
  @@map("bank_deposit_lines")
}

model InventoryCategory {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  parentId    String?             @map("parent_id") @db.Uuid
  code        String              @db.VarChar(30)
  name        String              @db.VarChar(150)
  description String?
  level       Int                 @default(0)
  path        String              @default("") @db.VarChar(1000)
  sortOrder   Int                 @default(0) @map("sort_order")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  company     Company             @relation(fields: [companyId], references: [id])
  parent      InventoryCategory?  @relation("InventoryCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    InventoryCategory[] @relation("InventoryCategoryTree")
  items       InventoryItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([parentId])
  @@map("inventory_categories")
}

model InventoryItemGroup {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(30)
  name        String          @db.VarChar(120)
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  company     Company         @relation(fields: [companyId], references: [id])
  items       InventoryItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("inventory_item_groups")
}

model ProductType {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(30)
  name        String          @db.VarChar(120)
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  items       InventoryItem[]
  company     Company         @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("inventory_product_types")
}

model Brand {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(30)
  name        String          @db.VarChar(120)
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  company     Company         @relation(fields: [companyId], references: [id])
  items       InventoryItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("inventory_brands")
}

model ItemSize {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(30)
  name        String          @db.VarChar(120)
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  company     Company         @relation(fields: [companyId], references: [id])
  items       InventoryItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("inventory_item_sizes")
}

model Origin {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(30)
  name        String          @db.VarChar(120)
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
