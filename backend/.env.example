NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:@localhost:5432/erp_financial_db
CORS_ORIGIN=http://localhost:3000
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=development-jwt-secret-do-not-use-in-prod
# How long a sign-in lasts before the user must sign in again.
JWT_EXPIRES_IN=12h

# Used only by `npm run seed:admin` to create the first Admin user. Remove after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Admin
