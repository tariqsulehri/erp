# Backend settings for the server. Copy to .env.backend and fill in. Never commit .env.backend.

# PostgreSQL connection for the application user.
DATABASE_URL=postgresql://erp_app:CHANGE_ME@db-host:5432/erp

# Private random value, at least 32 characters. Generate with: openssl rand -hex 32
# Must be different from NEXTAUTH_SECRET. The backend refuses to start without it.
JWT_SECRET=

# How long a sign-in token lasts. Keep equal to the frontend session (12h).
JWT_EXPIRES_IN=12h

# The address users open in the browser.
CORS_ORIGIN=https://erp.example.com

# Number of proxies in front of the backend (the Next.js proxy = 1). Used for the real client IP.
TRUST_PROXY_HOPS=1

# Used once to create the first Admin user (see DEPLOYMENT.md), then remove these two lines.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
