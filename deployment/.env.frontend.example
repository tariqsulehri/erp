# Frontend settings for the server. Copy to .env.frontend and fill in. Never commit .env.frontend.

# The address users open in the browser (https once Caddy is enabled).
NEXTAUTH_URL=https://erp.example.com

# Private random value, at least 32 characters. Generate with: openssl rand -hex 32
# Must be different from JWT_SECRET. Sign-in fails without it.
NEXTAUTH_SECRET=

# Backend address inside the Docker network (service name and PORT from docker-compose.yml).
BACKEND_API_INTERNAL_URL=http://backend:5000/api/v1

# Browser calls go through the frontend's /api/v1 proxy.
NEXT_PUBLIC_BACKEND_API_URL=/api/v1
