# Environment: development | staging | production
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:@localhost:5432/erp_financial_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=erp_financial_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_key_here_minimum_32_characters_long

# MinIO / S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=erp-files
S3_USE_SSL=false

# BullMQ Worker Configuration
WORKER_ENABLED=true
WORKER_CONCURRENCY=5

# Application Configuration
APP_NAME=ERP Financial Module
APP_PORT=3000
LOG_LEVEL=info
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001

# Email Configuration (optional, for later phases)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@example.com

# Feature Flags
ENABLE_MULTICOMPANY=true
ENABLE_INVENTORY_MODULE=false
ENABLE_AUDIT_LOG=true
