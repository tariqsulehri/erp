# Frontend settings for local development. Copy to .env.local and fill in. Never commit .env.local.

# The address you open in the browser.
NEXTAUTH_URL=http://localhost:3000

# Private random value, at least 32 characters: openssl rand -hex 32
NEXTAUTH_SECRET=

# Backend API used by the Next.js server (sign-in and the /api/v1 proxy). Never exposed to the browser.
BACKEND_API_INTERNAL_URL=http://localhost:4000/api/v1

# Browser calls go through the frontend's /api/v1 proxy.
NEXT_PUBLIC_BACKEND_API_URL=/api/v1
