{
  "name": "erp-financial-module",
  "version": "0.1.0",
  "description": "Professional-grade, multi-company ERP Financial Module built with Next.js",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json node_modules/.bin/typeorm migration:run -d src/db/migration.config.ts",
    "db:migrate:revert": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json node_modules/.bin/typeorm migration:revert -d src/db/migration.config.ts",
    "db:migrate:show": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json node_modules/.bin/typeorm migration:show -d src/db/migration.config.ts",
    "db:migrate:generate": "typeorm migration:generate -d dist/db/data-source.js src/db/migrations/$npm_config_name",
    "db:seed": "node dist/db/seeds/index.js",
    "worker:dev": "tsx watch src/worker/worker.ts",
    "worker:build": "tsc",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@auth/core": "^0.35.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@next/env": "^15.0.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.95.2",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "ag-grid-community": "^33.0.0",
    "ag-grid-react": "^33.0.0",
    "bullmq": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.0",
    "pg": "^8.11.0",
    "puppeteer": "^23.0.0",
    "query-string": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "redis": "^4.7.0",
    "superjson": "^2.2.1",
    "typeorm": "^0.3.20",
    "typescript": "^5.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.2.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.17.0"
  }
}
